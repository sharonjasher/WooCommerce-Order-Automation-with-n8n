        "jsCode": "// Prepare Dispatch: filter dispatched rows with empty Tracking Sent; normalize fields\nconst out = [];\n\nfunction pick(row, variants){\n  for (const k of variants) {\n    if (row[k] !== undefined && row[k] !== null && String(row[k]).trim() !== '') {\n      return String(row[k]).trim();\n    }\n  }\n  return '';\n}\n\nfor (let i = 0; i < items.length; i++) {\n  const row = items[i].json;\n\n  // shipping status (variants)\n  const shippingStatus = (pick(row, ['Shipping Status','Order status','Order Status','Shipping Staus','Status']) || '').toLowerCase();\n  if (shippingStatus !== 'dispatched') continue;\n\n  // skip if already sent\n  const trackingSent = (pick(row, ['Tracking Sent','TrackingSent','Tracking_Sent']) || '').toLowerCase();\n  if (trackingSent === 'yes' || trackingSent === 'notified') continue;\n\n  // normalize fields (handles header variants and trailing spaces)\n  const OrderID = pick(row, ['Order ID','OrderID','orderId','Number']);\n  const CustomerName = pick(row, ['Customer Name ','Customer Name','Name','customerName']);\n  const Email = pick(row, ['Email','email','E-mail','Customer Email']);\n  const Phone = pick(row, ['Phone','phone','Mobile']);\n  const Courier = pick(row, ['Courier','courier']);\n  const TrackingNo = pick(row, ['Tracking No','TrackingNo','Tracking','tracking']);\n  const Address = pick(row, ['Address','address']);\n  \n  // pad required field check\n  if(!Email || !OrderID) continue; // skip rows missing key info\n\n  out.push({\n    json: {\n      OrderID,\n      CustomerName,\n      Email,\n      Phone,\n      Courier,\n      TrackingNo,\n      Address,\n      SentAt: (new Date()).toISOString()\n    }\n  });\n}\n\nreturn out;\n"
      },
