        "jsCode": "// 🧠 Collect WooCommerce orders from previous node\nconst orders = $input.all().flatMap(item => item.json);\n\n// 🕒 Date helpers\nconst now = new Date();\nconst startOfYesterday = new Date(now);\nstartOfYesterday.setDate(startOfYesterday.getDate() - 1);\nstartOfYesterday.setUTCHours(0, 0, 0, 0);\n\nconst endOfYesterday = new Date(now);\nendOfYesterday.setDate(endOfYesterday.getDate() - 1);\nendOfYesterday.setUTCHours(23, 59, 59, 999);\n\nconst startOfLast7Days = new Date(now);\nstartOfLast7Days.setDate(startOfLast7Days.getDate() - 7);\nstartOfLast7Days.setUTCHours(0, 0, 0, 0);\n\nconst startOfPrevWeek = new Date(now);\nstartOfPrevWeek.setDate(startOfPrevWeek.getDate() - 14);\nstartOfPrevWeek.setUTCHours(0, 0, 0, 0);\n\nconst endOfPrevWeek = new Date(now);\nendOfPrevWeek.setDate(endOfPrevWeek.getDate() - 8);\nendOfPrevWeek.setUTCHours(23, 59, 59, 999);\n\n// 🔍 Filter helper\nconst filterByRange = (start, end) =>\n  orders.filter(o => new Date(o.date_created) >= start && new Date(o.date_created) <= end);\n\n// 🧾 Filter orders by period\nconst yesterdayOrders = filterByRange(startOfYesterday, endOfYesterday);\nconst weekOrders = filterByRange(startOfLast7Days, endOfYesterday);\nconst prevWeekOrders = filterByRange(startOfPrevWeek, endOfPrevWeek);\n\n// 💰 Sum revenue helper\nconst sumRevenue = arr => arr.reduce((s, o) => s + parseFloat(o.total || 0), 0);\n\n// 📊 Calculate totals\nconst totalRevenueYesterday = sumRevenue(yesterdayOrders);\nconst totalRevenueWeek = sumRevenue(weekOrders);\nconst totalRevenuePrevWeek = sumRevenue(prevWeekOrders);\n\n// 📈 Calculate growth %\nlet growth = 0;\nif (totalRevenuePrevWeek > 0) {\n  growth = ((totalRevenueWeek - totalRevenuePrevWeek) / totalRevenuePrevWeek * 100).toFixed(1);\n}\n\n// 🛍️ Create product count map for 7-day trend\nconst productCounts = {};\nfor (const order of weekOrders) {\n  if (order.line_items) {\n    for (const item of order.line_items) {\n      productCounts[item.name] = (productCounts[item.name] || 0) + item.quantity;\n    }\n  }\n}\n\n// 🏆 Top 3 products\nconst topProducts = Object.entries(productCounts)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 3)\n  .map(([name, qty]) => `${name} (${qty})`)\n  .join(', ') || 'No product data';\n\n// 📅 Create chart data for the last 7 days\nconst last7DaysLabels = [];\nconst last7DaysRevenue = [];\nfor (let i = 6; i >= 0; i--) {\n  const d = new Date(now);\n  d.setDate(d.getDate() - i);\n  const dayStart = new Date(d);\n  dayStart.setUTCHours(0, 0, 0, 0);\n  const dayEnd = new Date(d);\n  dayEnd.setUTCHours(23, 59, 59, 999);\n\n  const dayOrders = orders.filter(o => {\n    const created = new Date(o.date_created);\n    return created >= dayStart && created <= dayEnd;\n  });\n\n  const dayTotal = sumRevenue(dayOrders);\n  last7DaysLabels.push(d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }));\n  last7DaysRevenue.push(dayTotal);\n}\n\n// 🖼️ Generate QuickChart URL (Bar Chart)\nconst chartConfig = {\n  type: 'bar',\n  data: {\n    labels: last7DaysLabels,\n    datasets: [{\n      label: 'Daily Revenue (₹)',\n      backgroundColor: 'rgba(255, 206, 86, 0.7)', // soft yellow\n      borderColor: 'rgba(255, 206, 86, 1)',\n      borderWidth: 1,\n      data: last7DaysRevenue\n    }]\n  },\n  options: {\n    plugins: { legend: { display: false } },\n    scales: { y: { beginAtZero: true } },\n    layout: { padding: 10 }\n  }\n};\n\nconst chartUrl = `https://quickchart.io/chart?c=${encodeURIComponent(JSON.stringify(chartConfig))}`;\n\n// 🗣️ Voice Summary (for TTS Node)\nconst voiceSummary = `Hello Budding Kids Team! Yesterday, you had ${yesterdayOrders.length} completed orders totaling rupees ${totalRevenueYesterday.toFixed(2)}. \nFor the last seven days, total revenue was rupees ${totalRevenueWeek.toFixed(2)}, showing a ${growth >= 0 ? \"growth\" : \"decline\"} of ${Math.abs(growth)} percent compared to the previous week. \nTop products were: ${topProducts}.`;\n\n// 🧾 Return everything\nreturn [{\n  json: {\n    message: \"Sales Report Summary\",\n    totalOrdersYesterday: yesterdayOrders.length,\n    totalRevenueYesterday: totalRevenueYesterday.toFixed(2),\n    totalOrdersWeek: weekOrders.length,\n    totalRevenueWeek: totalRevenueWeek.toFixed(2),\n    totalRevenuePrevWeek: totalRevenuePrevWeek.toFixed(2),\n    growthPercent: growth,\n    chartUrl,\n    topProducts,\n    voiceSummary\n  }\n}];\n\n"
      },
