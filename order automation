        "jsCode": "const order = items[0].json;\n\n// ❗ STOP workflow if payment is NOT completed\nconst paidStatuses = [\"processing\", \"completed\"];\nif (!paidStatuses.includes(order.status)) {\n  return []; // exit — do not continue workflow\n}\n\nfunction s(v){ return v === undefined || v === null ? '' : v; }\n\n// Build full shipping address\nconst shippingAddress = [\n  s(order.shipping?.company),\n  (s(order.shipping?.first_name) + \" \" + s(order.shipping?.last_name)).trim(),\n  s(order.shipping?.address_1),\n  s(order.shipping?.address_2),\n  s(order.shipping?.city),\n  s(order.shipping?.state),\n  s(order.shipping?.postcode)\n].filter(p => p).join(\", \");\n\n// Order date\nconst orderDate = order.date_created \n  ? new Date(order.date_created).toISOString().split(\"T\")[0] \n  : new Date().toISOString().split(\"T\")[0];\n\nreturn [{\n  json: {\n    orderId: s(order.id),\n    customerName: (s(order.billing?.first_name) + \" \" + s(order.billing?.last_name)).trim(),\n    phone: s(order.billing?.phone),\n    email: s(order.billing?.email),\n    address: shippingAddress,\n    city: s(order.shipping?.city),\n    state: s(order.shipping?.state),\n    products: (order.line_items || []).map(it => `${it.name} x${it.quantity || 1}`).join('; '),\n    total: s(order.total),\n    payment: s(order.payment_method_title) || s(order.payment_method),\n    orderDate,\n    raw: order\n  }\n}];\n\n\n"
