              "value": "={{(() => {\n  const products = $input.all().flatMap(i => i.json);\n  const logoUrl = 'https://buddingkids.com/wp-content/uploads/2024/01/cropped-Sharon-Budding-Kids-logo.jpg'; // ✅ Your live logo\n  const accentColor = '#6a00ff'; // Purple\n  const highlight = '#ff4fa6';  // Pink\n\n  if (!products || products.length === 0) {\n    return `\n      <div style=\"font-family:Arial,Helvetica,sans-serif;background:#fafafa;padding:30px;text-align:center;\">\n        <img src=\"${logoUrl}\" alt=\"BuddingKids Logo\" style=\"max-width:220px;margin-bottom:20px;\">\n        <h2 style=\"color:${accentColor};\">Low Stock Alert 🚨</h2>\n        <p style=\"color:#555;\">All products currently have sufficient stock.</p>\n        <p style=\"font-size:12px;color:#aaa;margin-top:30px;\">&copy; ${new Date().getFullYear()} BuddingKids.com</p>\n      </div>`;\n  }\n\n  const rows = products.map(p => `\n    <tr>\n      <td style=\"padding:12px;border-bottom:1px solid #eee;\">${p.name}</td>\n      <td style=\"padding:12px;text-align:center;border-bottom:1px solid #eee;\">${p.stock_quantity ?? 'N/A'}</td>\n      <td style=\"padding:12px;text-align:center;border-bottom:1px solid #eee;\">\n        <a href=\"${p.permalink}\" target=\"_blank\" style=\"color:${accentColor};text-decoration:none;font-weight:bold;\">View</a>\n      </td>\n    </tr>\n  `).join('');\n\n  return `\n  <div style=\"font-family:Arial,Helvetica,sans-serif;background:#f8f8f8;padding:20px;\">\n    <div style=\"max-width:640px;margin:auto;background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,0.1);overflow:hidden;\">\n      <div style=\"background:#ffffff;padding:25px;text-align:center;border-bottom:3px solid ${highlight};\">\n        <img src=\"${logoUrl}\" alt=\"BuddingKids Logo\" style=\"max-width:220px;\">\n      </div>\n\n      <div style=\"padding:25px;\">\n        <h2 style=\"color:${accentColor};margin-bottom:10px;\">Low Stock Alert 🚨</h2>\n        <p style=\"color:#333;margin-bottom:20px;\">The following product(s) are below <strong>10 units</strong>:</p>\n\n        <table style=\"width:100%;border-collapse:collapse;font-size:15px;\">\n          <thead style=\"background:#f3f0ff;\">\n            <tr>\n              <th style=\"text-align:left;padding:10px;\">Product</th>\n              <th style=\"text-align:center;padding:10px;\">Stock</th>\n              <th style=\"text-align:center;padding:10px;\">Link</th>\n            </tr>\n          </thead>\n          <tbody>${rows}</tbody>\n        </table>\n\n        <p style=\"margin-top:25px;color:#555;\">Please restock soon to prevent running out of inventory.</p>\n      </div>\n\n      <div style=\"background:#f5f5f5;padding:15px;text-align:center;font-size:12px;color:#888;\">\n        &copy; ${new Date().getFullYear()} <a href=\"https://buddingkids.com\" style=\"color:${accentColor};text-decoration:none;\">BuddingKids.com</a> — Automated Inventory Notification\n      </div>\n    </div>\n  </div>`;\n})()}}\n\n",
